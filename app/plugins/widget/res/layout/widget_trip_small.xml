<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="Next trip"/>
            <TextView android:id="@+id/subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <ImageView android:id="@+id/refresh" android:layout_width="28dp" android:layout_height="28dp" android:padding="6dp"
            android:src="@drawable/widget_refresh" android:background="@drawable/widget_chip" android:contentDescription="Refresh"/>
        <TextView android:id="@+id/start" android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginStart="6dp"
            android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:visibility="gone"
            android:text="Start" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_text"
            android:background="@drawable/widget_chip" android:contentDescription="Start trip"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    <LinearLayout android:id="@+id/badge_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_badge" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp" android:paddingBottom="1dp"
            android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        <TextView android:id="@+id/sep2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"
            android:paddingStart="3dp" android:paddingEnd="3dp" android:text="›" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_secondary"/>
        <TextView android:id="@+id/badge2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"
            android:background="@drawable/widget_badge" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp" android:paddingBottom="1dp"
            android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1"/>
        <TextView android:id="@+id/sep3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"
            android:paddingStart="3dp" android:paddingEnd="3dp" android:text="›" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_secondary"/>
        <TextView android:id="@+id/badge3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"
            android:background="@drawable/widget_badge" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp" android:paddingBottom="1dp"
            android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1"/>
        <TextView android:id="@+id/platform" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="1"/>
    </LinearLayout>

    <Chronometer android:id="@+id/countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="32sp" android:textStyle="bold" android:textColor="@color/widget_text" android:fontFeatureSettings="tnum"/>
    <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"
        android:textSize="32sp" android:textStyle="bold" android:textColor="@color/widget_text"/>
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_secondary" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/next" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/notice" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
</LinearLayout>
