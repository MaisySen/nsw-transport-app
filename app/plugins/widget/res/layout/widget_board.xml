<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="14dp" android:paddingBottom="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" android:textStyle="bold" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="Departures"/>
            <TextView android:id="@+id/subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <ImageView android:id="@+id/refresh" android:layout_width="28dp" android:layout_height="28dp" android:padding="6dp"
            android:src="@drawable/widget_refresh" android:background="@drawable/widget_chip" android:contentDescription="Refresh"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:orientation="vertical">
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="34dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/b1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="34dp" android:gravity="center"
            android:background="@drawable/widget_badge" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1dp" android:paddingBottom="1dp"
            android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/d1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/s1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/t1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:textSize="17sp" android:textStyle="bold" android:textColor="@color/widget_text" android:fontFeatureSettings="tnum" android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="34dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/b2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="34dp" android:gravity="center"
            android:background="@drawable/widget_badge" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1dp" android:paddingBottom="1dp"
            android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/d2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/s2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:textSize="17sp" android:textStyle="bold" android:textColor="@color/widget_text" android:fontFeatureSettings="tnum" android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="34dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/b3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="34dp" android:gravity="center"
            android:background="@drawable/widget_badge" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1dp" android:paddingBottom="1dp"
            android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/d3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/s3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/t3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:textSize="17sp" android:textStyle="bold" android:textColor="@color/widget_text" android:fontFeatureSettings="tnum" android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="34dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/b4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="34dp" android:gravity="center"
            android:background="@drawable/widget_badge" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1dp" android:paddingBottom="1dp"
            android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/d4" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/s4" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/t4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:textSize="17sp" android:textStyle="bold" android:textColor="@color/widget_text" android:fontFeatureSettings="tnum" android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="34dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/b5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="34dp" android:gravity="center"
            android:background="@drawable/widget_badge" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1dp" android:paddingBottom="1dp"
            android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/d5" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/s5" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/t5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:textSize="17sp" android:textStyle="bold" android:textColor="@color/widget_text" android:fontFeatureSettings="tnum" android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row6" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="34dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/b6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="34dp" android:gravity="center"
            android:background="@drawable/widget_badge" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1dp" android:paddingBottom="1dp"
            android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/d6" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/s6" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/t6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:textSize="17sp" android:textStyle="bold" android:textColor="@color/widget_text" android:fontFeatureSettings="tnum" android:maxLines="1"/>
    </LinearLayout>
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
            android:textSize="13sp" android:textColor="@color/widget_secondary" android:visibility="gone"/>
    </LinearLayout>

    <TextView android:id="@+id/notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widget_secondary" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
