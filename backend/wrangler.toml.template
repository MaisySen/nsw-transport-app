# Cloudflare Worker for the Transport: Sydney Live API (api.transportsydney.app).
# tools/deploy-cloudflare.sh renders this file to wrangler.toml with values from the environment
# (CF_ACCOUNT_ID, D1_DATABASE_ID, R2_BLOCK). wrangler.toml is not committed. No secrets here:
# they are Worker secrets (wrangler secret put), see docs/DEPLOY_CLOUDFLARE.md.
name = "transport-api"
main = "dist/worker.mjs"
account_id = "${CF_ACCOUNT_ID}"
compatibility_date = "2026-08-01"
compatibility_flags = ["nodejs_compat"]
workers_dev = false
preview_urls = false
# Smaller script: less to parse and compile in each fresh isolate (most requests start one).
minify = true
# Smart Placement: Cloudflare runs the worker near what it calls most (the Transport for NSW hub and D1, both in
# Sydney) when that is faster than running it near the phone.
[placement]
mode = "smart"

# Workers Logs (docs/DIAGNOSIS_LAG.md item 10): the request lines (reqLog) and errors, kept up to 7 days on Workers
# Paid. One request in 10 is kept, which stays well inside the included log events and still gives p95 per endpoint.
# Invocation logs are off: they hold each request's full address, and the query can carry the install ID, a
# position for stops near you or an Ask question. The reqLog line has the path only, so the privacy policy can say
# positions and Ask questions are not kept (store/apple/app-privacy.md, 26 Oct, g25).
[observability]
enabled = true
head_sampling_rate = 0.1

[observability.logs]
invocation_logs = false

# The static files the API reads (stations, stops, facilities) and the shared live trip page.
# The worker runs first so the API host never serves anything it does not route.
[assets]
directory = "dist/public"
binding = "ASSETS"
run_worker_first = true

[vars]
API_ONLY = "1"
ENGINE_BOARDS = "off"
# Budget mode (docs/COSTS.md, owner's rule 26 Oct: US$5 a month, no overage, up to 1,000 people). Every alarm and every
# call between objects is a billed Durable Object request (1 million a month included). 4 shards are plenty for
# 1,000 people (each hot shard costs about 24 requests a minute); raise ENGINE_SHARDS again for more. An idle engine
# object stops its alarm after ENGINE_IDLE_MIN minutes with no reads (15 in the code).
ENGINE_SHARDS = "4"
ENGINE_IDLE_MIN = "5"
# Platform names and missing lines sent to the engine from Trip Planner boards (one object request each): only while
# the engine serves boards, or when this is "on".
ENGINE_LEARN = "off"
# Stand and platform names for engine boards (docs/ENGINE.md "Stand names"): the core object reads a stop's planner
# board itself from a queue the shards fill (no extra object request; at most ENGINE_LEARN_PER_MIN 30 a minute and
# ENGINE_LEARN_DAY 2,000 a day). Not set means on; ENGINE_LEARN_CORE "off" goes back to a read on a phone's first read,
# and ENGINE_LEARN_MOVED "off" keeps no moved stand (a bus shown at a temporary stand instead of its planned one).
# Load test keys work only when "on". Never on production: the 1,000 phone soak of 26 Oct used about 70,000 Durable
# Object requests in one hour (7% of the month's included amount). Test on wrangler dev with a fake Transport for NSW.
LOAD_TESTS = "off"
# Budget guard (worker.js budgetCheck): the account its hourly usage read covers (the read only analytics token is the
# CF_ANALYTICS_TOKEN secret), the day of the month the billing cycle starts (UTC, 25: the cycle runs 25th to 25th)
# and the log sampling rate below.
CF_ACCOUNT_ID = "${CF_ACCOUNT_ID}"
BILLING_DAY = "25"
LOG_SAMPLING = "0.1"
# Live push for boards on the Trip Planner path (src/livehub.js, docs/API.md "GET /api/live"): "on" opens the LIVE
# objects' sockets; "off" answers /api/live with 404 unless the engine pushes the stop (ENGINE_PUSH), and phones poll.
LIVE_PUSH = "off"
# One JSON line per /api request (src/worker.js reqLog, docs/API.md "Request numbers"); "off" stops it.
REQ_LOG = "on"
# Our own trip planner (src/raptor.js, docs/SCALE_1M.md): "on" answers trip searches from our timetable, no Transport for
# NSW call; REPLICAS objects share the searches (each copies the pack from the first).
OWN_PLANNER = "off"
OWN_PLANNER_REPLICAS = "1"
API_HOST = "api.transportsydney.app"
SITE_URL = "https://transportsydney.app"
VAPID_SUBJECT = "mailto:hello@transportsydney.app"
# iPhone trip card pushes (the key itself is the secret APNS_KEY).
APNS_BUNDLE = "com.maisysen.nswtransport"
APNS_KEY_ID = "69AK74573Z"
APNS_TEAM_ID = "B85KQRQZW7"

# Board engine (src/engine.js, docs/ENGINE.md): one Durable Object with the GTFS timetable in its SQLite storage
# builds every stop's board from the network realtime feeds every 10 s. ENGINE_BOARDS "on" serves /api/departures
# from it; "off" keeps the Trip Planner path (engine=1 on a request still asks the engine, for checks).
[[durable_objects.bindings]]
name = "ENGINE"
class_name = "BoardEngine"

# Board shards (docs/ENGINE.md, "Shards"): ENGINE_SHARDS objects build the boards, a stop always in the same one, and
# write them to Cloudflare's cache; the core object above keeps the timetable and the one copy of each feed.
[[durable_objects.bindings]]
name = "SHARDS"
class_name = "BoardShard"

# Live push (src/livehub.js): one object per stop and mode with the phones' sockets on that stop's screen.
[[durable_objects.bindings]]
name = "LIVE"
class_name = "LiveHub"

# Our own trip planner (src/raptor.js, docs/SCALE_1M.md): the timetable pack in SQLite, searched with RAPTOR in memory.
# OWN_PLANNER "on" answers trip searches from it (no Transport for NSW call); "off" keeps the Trip Planner.
[[durable_objects.bindings]]
name = "PLANNER"
class_name = "TripPlanner"

[[migrations]]
tag = "engine-v1"
new_sqlite_classes = ["BoardEngine"]

[[migrations]]
tag = "engine-v2"
new_sqlite_classes = ["BoardShard"]

[[migrations]]
tag = "live-v1"
new_sqlite_classes = ["LiveHub"]

[[migrations]]
tag = "planner-v1"
new_sqlite_classes = ["TripPlanner"]

# Budget guard emails (worker.js budgetMail) through Email Routing on transportsydney.app, to its verified address only.
[[send_email]]
name = "ALERT_EMAIL"
destination_address = "contact@fintex.au"

[[d1_databases]]
binding = "DB"
database_name = "transport"
database_id = "${D1_DATABASE_ID}"
migrations_dir = "migrations"

[[routes]]
pattern = "api.transportsydney.app"
custom_domain = true

# The minute tick (watches, commutes, morning checks, lift and car park alerts, clean up).
[triggers]
crons = ["* * * * *"]
${R2_BLOCK}
