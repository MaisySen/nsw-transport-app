/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; manifest-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), browsing-topics=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# HTML pages: no-transform stops the zone adding scripts to the pages (its email link rewriter and its
# analytics beacon). The site has no scripts, no analytics and no tracking; see docs/RUNBOOK.md.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/support/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/privacy/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/terms/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/404.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/open/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/trip
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/trip/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/stop/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/plan
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/plan/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/site.css
  Cache-Control: public, max-age=3600

/*.png
  Cache-Control: public, max-age=86400

/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600

/open/*
  X-Robots-Tag: noindex
